{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ishayahu.github.io/jewish-chrono/christianity/data/schema.json",
  "title": "Canonical Christian controversy JSON-LD",
  "type": "object",
  "required": [
    "@context",
    "@graph"
  ],
  "properties": {
    "@context": {
      "type": "object"
    },
    "@graph": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "@id",
          "@type"
        ],
        "properties": {
          "@id": {
            "type": "string",
            "pattern": "^https://ishayahu\\\\.github\\\\.io/jewish-chrono/christianity/data/graph\\\\.jsonld#"
          },
          "@type": {
            "enum": [
              "HistoricalAtlas",
              "DoctrinalPosition",
              "Controversy",
              "ComparativeQuestion",
              "PositionClaim",
              "ReasoningLink",
              "OpenResearchQuestion",
              "Source"
            ]
          }
        }
      }
    }
  },
  "description": "A single @graph file contains every position, comparison, claim, reasoning link, research gap and source. For referential integrity use the accompanying Node tests."
}
